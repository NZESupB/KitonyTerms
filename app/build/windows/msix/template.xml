<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="kitonyterms"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\KitonyTerms">
    </Installer>
    <PackageInformation
        PackageName="KitonyTerms"
        PackageDisplayName="KitonyTerms"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.1.19.0"
        PackageDescription="A kitonyterms application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.kitonyterms.app"
                Description="A kitonyterms application"
                DisplayName="KitonyTerms"
                ExecutableName="kitonyterms"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>KitonyTerms</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>A kitonyterms application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="kitonyterms.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
